{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/*"],
      "@/layout/*": ["./src/components/layout/*"],
      "@/sections/*": ["./src/components/sections/*"],
      "@/ui/*": ["./src/components/ui/*"],
      "@/providers/*": ["./src/components/providers/*"],
      "@/context/*": ["./src/context/*"],
      "@/data/*": ["./src/data/*"],
      "@/utils/*": ["./src/utils/*"]
    }
  },
  "exclude": ["node_modules", ".next", "out"]
}
